# Copy to .env.local and adjust as needed. Every value is optional for local development.

# HMAC key for session cookies and click signatures. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Public base URL used for short links, QR payloads and email links.
# APP_URL=http://localhost:3000

# Absolute path to the SQLite file (defaults to data/linkshort.db).
# DATABASE_PATH=

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
# COOKIE_SECURE=1
